          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Order": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/OrderLine"
            },
            "title": "Lines",
            "type": "array"
          },
          "status": {
            "enum": [
              "pending",
              "confirmed"
            ],
            "title": "Status",
            "type": "string"
          },
          "totalCents": {
            "title": "Totalcents",
            "type": "integer"
          },
          "updatedAt": {
            "format": "date-time",
            "title": "Updatedat",
            "type": "string"
          },
          "userId": {
            "title": "Userid",
            "type": "string"
          }
        },
        "required": [
          "id",
          "userId",
          "status",
          "totalCents",
          "lines",
          "createdAt",
          "updatedAt"
        ],
        "title": "Order",
        "type": "object"
      },
      "OrderItem": {
        "properties": {
          "productId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Productid",
            "type": "string"
          },
          "quantity": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "productId",
          "quantity"
        ],
        "title": "OrderItem",
        "type": "object"
      },
      "OrderLine": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "priceCents": {
            "title": "Pricecents",
            "type": "integer"
          },
          "productId": {
            "title": "Productid",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "integer"
          }
        },
        "required": [
          "productId",
          "name",
          "quantity",
          "priceCents"
        ],
        "title": "OrderLine",
        "type": "object"
      },
      "OrderRequest": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "maxItems": 50,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "userId": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Userid",
            "type": "string"
          }
        },
        "required": [
          "userId",
          "items"
        ],
        "title": "OrderRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
